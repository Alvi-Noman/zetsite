JWT_SECRET=super-secret-key-change-me
MONGODB_URI=mongodb://localhost:27017/zetsite
PORT=4001
NODE_ENV=development

# --- Multi-tenant published sites -------------------------------------------------------------
# Root domain that per-tenant published sites live under as *.<domain> subdomains, e.g. zetsite.com.
# Checked by auth-service's on-demand-TLS "allow" endpoint before Caddy issues a cert for a subdomain.
SITE_ROOT_DOMAIN=
PUBLIC_APP_URL=http://localhost:3100

# --- CORS --------------------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3100,http://127.0.0.1:3100

# --- Landing pages: optional AI text enhancement ------------------------------------------------
# Landing pages always generate via the native, deterministic builder (no key needed).
# Set these to also have OpenAI polish specific text fields on top of that draft.
# Get a key at https://platform.openai.com (separate from any ChatGPT subscription).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# --- ZetSales integration (Settings > Connected apps) --------------------------------------------
# One static, trusted partner app rather than a full OAuth-client registry — zetsales is a
# separate product the same operator owns, not a public app marketplace. All three values must
# match exactly on zetsales' own commerce-service .env.
# The exact callback URL zetsales' OAuth flow redirects back to — requests to
# /oauth/authorize with any other redirect_uri are rejected.
ZETSALES_REDIRECT_URI=
# Sent as the X-Integration-Secret header when zetsales exchanges an auth code for an access
# token (POST /api/v1/auth/integrations/token) — proves the caller really is zetsales' backend,
# not just anyone who intercepted a code.
ZETSALES_INTEGRATION_SECRET=
# Signs outbound product/order webhooks pushed to zetsales (HMAC-SHA256, same convention
# zetsales' own Shopify/WooCommerce webhook receivers already use).
ZETSITE_WEBHOOK_SECRET=
